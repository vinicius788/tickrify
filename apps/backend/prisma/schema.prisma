generator client {
  provider = "prisma-client-js"
  // Necessário para Vercel (Node serverless em Debian/openssl 1.1)
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["tickrify"]
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String?
  name        String?
  role        String   @default("user") // user, admin
  plan        String   @default("FREE") // FREE, PRO, PREMIUM
  createdAt   DateTime @default(now())

  // Stripe fields
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String? // active, canceled, past_due, etc

  // Perfil de estrategia do trader (recurso pago). Campos FECHADOS, validados
  // por sanitizeStrategyProfile — nada que o usuario digitou chega ao prompt.
  strategyProfile Json?

  // Como a pessoa descobriu o produto, perguntado no primeiro acesso ao painel.
  // Existe porque a atribuicao por UTM/cookie nao respondeu: o PostHog so ve
  // quem aceita cookies, $initial_utm_source vem vazio, e em 09/2026 os tres
  // primeiros assinantes chegaram sem que desse para dizer de onde. Esta
  // coluna e a unica fonte de primeiro toque que nao depende de cookie.
  acquisitionSource   String?
  acquisitionDetail   String?
  acquisitionAnsweredAt DateTime?

  // Atribuicao tecnica first/last-touch capturada de parametros UTM/referrer.
  // Complementa a pergunta declarada acima: nao depende do PostHog aceitar
  // cookies e acompanha o usuario ate o webhook da Stripe.
  firstTouchAttribution Json?
  firstTouchAt         DateTime?
  lastTouchAttribution Json?
  lastTouchAt          DateTime?
  // Reset unico da cota gratis: preenchido a mao (SQL), a contagem so considera
  // analises criadas depois dele. Ver common/free-quota.ts.
  freeQuotaResetAt     DateTime?

  subscriptions Subscription[]
  analyses      Analysis[]
  analysisUsage AnalysisUsage[]
  promptAudits  PromptAudit[]
  adminAudits   AdminAudit[] @relation("AdminAuditActor")
  adminTargets  AdminAudit[] @relation("AdminAuditTarget")
  featureFlags  FeatureFlag[] @relation("FeatureFlagUpdatedBy")
  problemReports ProblemReport[] @relation("ProblemReportAuthor")
  affiliate      Affiliate?
  referredBy     AffiliateReferral?

  @@schema("tickrify")
}

model Subscription {
  id        String   @id @default(cuid())
  userId    String
  stripeId  String   @unique
  status    String
  priceId   String?
  /// Periodo de cobranca atual (da Stripe). Define a janela mensal de ticks
  /// sem chamar a Stripe a cada analise. NULL no acesso manual.
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("tickrify")
}

model Analysis {
  id             String   @id @default(cuid())
  userId         String
  imageUrl       String? // Opcional - imagem não é mais salva para economizar espaço
  status         String // pending, processing, completed, failed
  recommendation String? // "BUY", "SELL", "WAIT"
  confidence     Float? // 0-100
  reasoning      String?  @db.Text
  result         Json?
  fullResponse   String?  @db.Text
  errorMessage   String?  @db.Text
  errorCode      String? // Categoria estável da falha definitiva; nunca mensagem livre
  promptVer      Int?
  // Modelo da OpenAI que gerou a análise. Sem isto não é possível comparar
  // calibração antes/depois de uma troca de modelo — e a troca gpt-4o-mini →
  // gpt-5.6 é obrigatória (shutdown do gpt-4o em 23/10/2026).
  model          String?
  // Hash do perfil de estrategia vigente quando esta analise rodou. NULL = sem
  // estrategia. As quatro queries publicas (esteira da landing e as tres da
  // /accuracy) filtram por NULL, para que preferencia de usuario nunca entre na
  // amostra que o site publica. Mesma licao da separacao outcome/userVerdict.
  strategyHash   String?
  isDemo         Boolean  @default(false)
  // ── Outcome tracking: 48h após a análise, o worker verifica nos candles reais
  // se TP1 saiu antes do SL (mesma régua do backtest — scripts/backtest/evaluate.py).
  // outcome: WIN | LOSS | TIMEOUT | NO_FILL | ABSTAIN | INCOMPLETE | UNTRACKABLE
  outcome        String?
  outcomeAt      DateTime?
  outcomeDetail  Json?
  // Veredicto MANUAL do trader (My Trades): tp1 | tp2 | stop | breakeven | open.
  // Coluna separada de propósito (27/07/2026): antes os dois moravam em
  // `outcome` e se destruíam — o veredicto manual bloqueava o sweeper (que
  // busca por outcome=null) e o sweeper apagava o veredicto do usuário.
  // `outcome` = o que o mercado fez (medido). `userVerdict` = o que o trader diz.
  userVerdict    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
  @@index([outcome, createdAt])
  @@index([promptVer, outcome])
  @@schema("tickrify")
}

model AnalysisUsage {
  id          String   @id @default(cuid())
  userId      String
  periodType  String // MONTH
  periodStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodStart])
  @@index([periodType, periodStart])
  @@schema("tickrify")
}

model UserTicks {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions TickTransaction[]

  @@map("user_ticks")
  @@schema("tickrify")
}

model TickTransaction {
  id                    String     @id @default(cuid())
  userId                String
  amount                Int // positivo = crédito, negativo = débito
  type                  TickTxType
  description           String
  stripePaymentIntentId String?    @unique
  metadata              Json?
  createdAt             DateTime   @default(now())

  userTicks UserTicks @relation(fields: [userId], references: [userId])

  @@map("tick_transactions")
  @@schema("tickrify")
}

enum TickTxType {
  PURCHASE
  USAGE
  REFUND
  BONUS

  @@schema("tickrify")
}

model PromptConfig {
  id        String        @id @default(cuid())
  version   Int           @unique
  prompt    String        @db.Text
  isActive  Boolean       @default(false)
  createdAt DateTime      @default(now())
  audits    PromptAudit[]

  @@index([isActive])
  @@schema("tickrify")
}

model PromptAudit {
  id               String        @id @default(cuid())
  promptConfigId   String?
  action           String
  actorUserId      String
  actorClerkUserId String
  payload          Json?
  createdAt        DateTime      @default(now())
  promptConfig     PromptConfig? @relation(fields: [promptConfigId], references: [id], onDelete: SetNull)
  actorUser        User          @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@schema("tickrify")
}

model AdminAudit {
  id         String   @id @default(cuid())
  actorUserId String?
  targetUserId String?
  targetEmail String?
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  actorUser  User? @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@schema("tickrify")
}

/// Loja de apps interna: liga/desliga funções sem redeploy.
///
/// Antes disto, mudar qualquer flag exigia abrir o painel do Render, editar a
/// variável de ambiente e esperar o redeploy — e não ficava registro nenhum de
/// quem mexeu. Um `ENABLE_QUICK_GROUNDING` desligado por engano fazia a vitrine
/// vender uma feature que a produção não entregava, sem ninguém saber desde quando.
///
/// Esta tabela guarda apenas os OVERRIDES. A ordem de resolução é
/// banco → variável de ambiente → padrão do código, então uma linha ausente
/// aqui significa "usa o que sempre usou". Banco fora do ar = tudo volta ao
/// comportamento por env, sem quebrar nada.
model FeatureFlag {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@schema("tickrify")
}

/// Relato de problema enviado pelo usuário, com o contexto técnico junto.
///
/// O campo `context` guarda o que o navegador sabia na hora: rota, tamanho de
/// tela, idioma, fuso, e as últimas ações do usuário (migalhas). É o que
/// transforma "não funcionou" em algo reproduzível.
///
/// `status` é máquina de estados fechada, garantida por CHECK no banco:
/// aberto → investigando → resolvido | descartado.
model ProblemReport {
  id         String    @id @default(cuid())
  userId     String?
  message    String    @db.Text
  route      String?
  analysisId String?
  context    Json?
  status     String    @default("aberto")
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation("ProblemReportAuthor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@schema("tickrify")
}

/// Registro dos webhooks da Stripe: cada `id` de evento e processado UMA vez.
/// status: processing | processed | failed. `failed` e retomado no proximo
/// reenvio da Stripe; `processing` parado ha mais de 5 min tambem.
/// Em producao a tabela nasce pelo `CREATE TABLE IF NOT EXISTS` do
/// StripeService.onModuleInit (RUN_MIGRATIONS_ON_START=false).
model StripeWebhookEvent {
  id          String    @id
  type        String
  status      String
  attempts    Int       @default(1)
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, updatedAt])
  @@schema("tickrify")
}

/// Programa de afiliados. Dinheiro SEMPRE em centavos de USD (Int) e taxa em
/// pontos-base (2000 = 20%): nada de ponto flutuante em valor financeiro.
/// Em producao as tabelas nascem pelo `CREATE TABLE IF NOT EXISTS` do
/// AffiliatesService.onModuleInit (RUN_MIGRATIONS_ON_START=false).
///
/// status: PENDING (pedido) -> ACTIVE (aprovado) | REJECTED; ACTIVE <-> SUSPENDED.
/// So ACTIVE gera atribuicao, comissao e saque. `commissionRateBps` acima do padrao e acordo
/// individual feito pelo admin; nunca aparece em pagina publica.
model Affiliate {
  id                    String   @id @default(cuid())
  userId                String   @unique
  referralCode          String   @unique
  couponCode            String   @unique
  commissionRateBps     Int      @default(2000)
  status                String   @default("PENDING")
  /// Promotion code da Stripe que carrega o `couponCode` (sobre o cupom de
  /// STRIPE_AFFILIATE_COUPON_ID). NULL = cupom da Stripe nao configurado.
  stripePromotionCodeId String?  @unique
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks      AffiliateClick[]
  referrals   AffiliateReferral[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  @@schema("tickrify")
}

/// Clique num link ?ref=. Sem IP nem dado pessoal: so conta e ancora a janela
/// de 30 dias (o servidor confere a data do clique, nao o navegador).
model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  landingPath String?
  createdAt   DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId, createdAt])
  @@schema("tickrify")
}

/// Quem indicou quem. Um por usuario indicado. `source` = link | coupon (o
/// cupom tem prioridade e substitui o link enquanto nao houve pagamento).
/// `firstPaidAt` trava o vinculo e abre os 12 meses de comissao.
model AffiliateReferral {
  id               String    @id @default(cuid())
  affiliateId      String
  userId           String    @unique
  source           String
  clickId          String?
  firstPaidAt      DateTime?
  commissionEndsAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions AffiliateCommission[]

  @@index([affiliateId, createdAt])
  @@schema("tickrify")
}

/// Uma comissao por fatura paga da Stripe (`stripeInvoiceId` unico = sem
/// duplicidade em reenvio de webhook).
/// status: PENDING (30 dias) -> AVAILABLE -> PAID; refund/disputa -> CANCELLED.
model AffiliateCommission {
  id                    String    @id @default(cuid())
  affiliateId           String
  referralId            String?
  referredUserId        String
  stripeInvoiceId       String    @unique
  stripeChargeId        String?
  stripePaymentIntentId String?
  amountPaidCents       Int
  commissionCents       Int
  rateBps               Int
  status                String    @default("PENDING")
  availableAt           DateTime
  payoutId              String?
  cancelledReason       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  affiliate Affiliate          @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral  AffiliateReferral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  payout    AffiliatePayout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
  @@index([status, availableAt])
  @@index([stripeChargeId])
  @@index([stripePaymentIntentId])
  @@schema("tickrify")
}

/// Saque manual. status: REQUESTED -> APPROVED -> PAID, ou REJECTED.
/// As comissoes AVAILABLE entram no pedido (payoutId) e so viram PAID junto.
model AffiliatePayout {
  id           String    @id @default(cuid())
  affiliateId  String
  amountCents  Int
  status       String    @default("REQUESTED")
  method       String
  adminNote    String?
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?
  paidAt       DateTime?
  decidedById  String?

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissions AffiliateCommission[]

  @@index([affiliateId, status])
  @@index([status, requestedAt])
  @@schema("tickrify")
}
