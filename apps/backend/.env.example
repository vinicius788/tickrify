# ============================================
# TICKRIFY BACKEND - ENVIRONMENT EXAMPLE
# ============================================

# Runtime
NODE_ENV=development
APP_ENV=dev
PORT=3001
DEMO_MODE=false

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/ticrif
# Migration URL (recommended for migrate status/deploy; fallback is DATABASE_URL)
MIGRATIONS_DATABASE_URL=postgresql://user:password@localhost:5432/ticrif
DIRECT_URL=postgresql://user:password@localhost:5432/ticrif
# Compatibilidade com provedores que usam nome alternativo
DIRECT_DATABASE_URL=postgresql://user:password@localhost:5432/ticrif

# Queue (required in production)
REDIS_URL=rediss://default:password@host:port
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth (required in production)
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY_HERE
CLERK_JWT_KEY=
CLERK_ISSUER=https://your-tenant.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
BOOTSTRAP_ADMIN_EMAILS=
ALLOW_LEGACY_AUTH_FALLBACK=false

# Storage (required in production)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=analysis-images
SUPABASE_STORAGE_PUBLIC_BASE_URL=
# Local dev helper: when true, skips remote storage upload and keeps image as data URL.
USE_LOCAL_STORAGE=false
MAX_IMAGE_UPLOAD_BYTES=10485760

# AI (required in production)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
AI_MODEL=gpt-4o

# Billing (required when Stripe is enabled)
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# App URLs / CORS
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ──────────────────────────────────────────────
# SEGURANÇA — Health Endpoints Internos
# Token para acessar /api/health e /api/health/ready
# Gere com: openssl rand -hex 32
# Sem este valor, os endpoints retornam 403 por padrão (comportamento esperado)
# ──────────────────────────────────────────────
INTERNAL_OPS_TOKEN=

# ──────────────────────────────────────────
# Clerk (opcionais, usados no código)
# ──────────────────────────────────────────
CLERK_AUDIENCE=

# ──────────────────────────────────────────
# Stripe — origens adicionais de retorno
# ──────────────────────────────────────────
STRIPE_ALLOWED_RETURN_ORIGINS=

# ══════════════════════════════════════════════════════════════════════════
#  MOTOR DE IA — modelos e tempo limite
# ══════════════════════════════════════════════════════════════════════════
# Modelo por tipo de análise. AI_MODEL_QUICK vale para a análise rápida (1 tick)
# e AI_MODEL_DEEP para a profunda (3 ticks).
# ⚠️ PRAZO DURO: o gpt-4o desliga em 23/10/2026 e ainda é o padrão do DEEP.
AI_MODEL_QUICK=
AI_MODEL_DEEP=
# Esforço de raciocínio opcional: minimal, low, medium ou high.
AI_REASONING_EFFORT_QUICK=
AI_REASONING_EFFORT_DEEP=
# Teto de tempo da chamada à OpenAI, em ms. Subiu para 180000 quando a decisão
# passou a ser gerada no FIM do JSON: truncar deixou de ser "resposta cortada"
# e virou "veredito perdido".
AI_ANALYZE_TIMEOUT_MS=
# Despeja a resposta crua do modelo no log. NUNCA ligar em produção.
AI_DEBUG_DUMP_RAW=

# ══════════════════════════════════════════════════════════════════════════
#  LOJA DE APPS — valores PADRÃO das funções
# ══════════════════════════════════════════════════════════════════════════
# Estas variáveis são o segundo nível de resolução das flags:
#   banco (painel /admin)  →  ESTAS VARIÁVEIS  →  padrão do código
# Um override gravado pelo painel IGNORA o valor daqui. Para conferir o que
# está valendo de verdade, olhe /api/health ou o painel — não este arquivo.
#
# Injeta candles reais no prompt. A VITRINE VENDE ISTO ("live candle grounding").
ENABLE_QUICK_GROUNDING=
# Guarda de evento econômico: rebaixa o sinal perto de payroll/CPI.
ENABLE_NEWS_GUARD=
# Guarda de risco/retorno: rebaixa sinal com R:R abaixo de 1.2.
ENABLE_RR_GUARD=
# Contexto de mercado (funding, open interest, long/short) na análise profunda.
ENABLE_MARKET_ENRICHMENT=
# Sweeper que mede WIN/LOSS 48h depois. Desligar congela a página /accuracy.
ENABLE_OUTCOME_TRACKING=
# % de usuários no prompt v9 (0–100). Sorteio estável POR USUÁRIO.
# ⚠️ Não subir junto com troca de modelo: os dois ao mesmo tempo invalidam o teste.
AB_PROMPT_V9_PERCENT=
# Sincroniza o prompt ativo no boot.
PROMPT_AUTO_SYNC=

# ══════════════════════════════════════════════════════════════════════════
#  DEMO ANÔNIMA (/try)
# ══════════════════════════════════════════════════════════════════════════
# Sal secreto do hash de IP e fingerprint. NUNCA persistimos esses valores em
# claro (LGPD/GDPR). Trocar este sal zera a cota de todo mundo.
DEMO_HASH_SALT=
# Teto de análises demo CONCLUÍDAS por IP em 24h. Padrão 3. É o que limita o
# custo máximo de API por IP mesmo com rotação de fingerprint.
DEMO_IP_DAILY_CAP=
# Anti-bot Cloudflare Turnstile, verificado no servidor.
# Sem esta chave o desafio fica DESATIVADO (passa com aviso no log).
TURNSTILE_SECRET_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  DADOS DE MERCADO
# ══════════════════════════════════════════════════════════════════════════
# Forex e ouro (XAUUSD, EURUSD). Sem ela, esses símbolos ficam UNTRACKABLE no
# sweeper de acerto — cripto continua funcionando por OKX/Binance.
TWELVE_DATA_API_KEY=
# Calendário econômico (FRED).
FRED_API_KEY=

# ══════════════════════════════════════════════════════════════════════════
#  E-MAIL E TELEMETRIA
# ══════════════════════════════════════════════════════════════════════════
RESEND_API_KEY=
# Remetente. Antes de verificar o domínio no Resend, use o de teste padrão.
MAIL_FROM=
POSTHOG_KEY=
POSTHOG_HOST=
# Permite telemetria em testes somente quando explicitamente true.
POSTHOG_ENABLE_IN_TEST=false

# ══════════════════════════════════════════════════════════════════════════
#  BACKTEST (scripts locais, não usado em produção)
# ══════════════════════════════════════════════════════════════════════════
BT_DEBUG_FIELDS=
