# Clerk Authentication
# Get your publishable key from https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY_HERE

# Backend API
# Defina SEMPRE a URL do backend em produção (ex: https://api.tickrify.com)
# Em desenvolvimento, mantenha localhost:
VITE_API_URL=http://localhost:3001

# Stripe (opcional - para pagamentos)
VITE_STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY_HERE
# Ative apenas se STRIPE_PRICE_PRO_ANNUAL estiver configurado no backend
VITE_ENABLE_ANNUAL_BILLING=false

# PostHog (analytics do funil) - https://posthog.com (free tier: 1M eventos/mês)
VITE_POSTHOG_KEY=phc_YOUR_POSTHOG_PROJECT_KEY
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google Analytics 4 (opcional) - mede canal de origem (orgânico, Instagram,
# direto...). Deixe vazio = desligado.
VITE_GA_TRACKING_ID=
VITE_GOOGLE_ADS_ID=

# Meta Pixel (opcional) - fecha o loop Reels/Instagram -> site -> conversão.
# Deixe vazio = desligado.
VITE_META_PIXEL_ID=

# Sentry (observabilidade de erros) - https://sentry.io (free tier: 5k erros/mês)
# Deixe vazio para desativar o Sentry.
VITE_SENTRY_DSN=
# Ambiente reportado ao PostHog/Sentry (ex: production, staging)
VITE_APP_ENV=development

# Cloudflare Turnstile (anti-bot da demo anonima /try)
# Sitekey PUBLICA do widget, obtida em https://dash.cloudflare.com > Turnstile.
# Deixe VAZIA em desenvolvimento: sem ela o desafio vira no-op e a demo roda
# normalmente (o backend so exige o token quando TURNSTILE_SECRET_KEY existe la).
#
# ATENCAO EM PRODUCAO: esta chave e o TURNSTILE_SECRET_KEY do backend precisam
# ser do MESMO widget, e o dominio publico precisa estar na lista de hostnames
# permitidos do widget. Chave errada, widget apagado ou dominio fora da lista
# fazem a Cloudflare devolver o erro 400020 e TODA a demo passa a responder
# "Human verification failed" — sem alerta nenhum. Foi o que aconteceu em
# producao ate 03/09/2026.
VITE_TURNSTILE_SITE_KEY=
