# ===================================
# TICKRIFY FRONTEND - PRODUCTION ENV
# ===================================
# 
# Este arquivo contém TODAS as variáveis necessárias para produção do frontend.
# Copie este arquivo e configure na Vercel Dashboard.
#

# ===================================
# API BACKEND
# ===================================
# URL pública do backend (obrigatória em produção).
# Exemplo Railway custom domain: https://api.tickrify.com
VITE_API_URL=https://api.tickrify.com

# ===================================
# AUTHENTICATION - CLERK
# ===================================
# Obtenha em: https://dashboard.clerk.com
# Use a MESMA chave do backend
VITE_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY_HERE

# ===================================
# ANTI-BOT - CLOUDFLARE TURNSTILE
# ===================================
# Sitekey PUBLICA do widget: https://dash.cloudflare.com > Turnstile
# Precisa ser do MESMO widget cujo secret esta em TURNSTILE_SECRET_KEY no
# backend, e o dominio de producao precisa estar na lista de hostnames
# permitidos do widget.
#
# Se a chave nao bater, a Cloudflare devolve 400020 (invalid sitekey), o
# frontend nao consegue token e o backend rejeita TODA requisicao da demo com
# "Human verification failed". A pagina de maior conversao do funil para de
# converter e nada dispara alerta. Ao trocar esta variavel, faca REBUILD: ela
# entra no bundle em tempo de build, redeploy do mesmo artefato nao adianta.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY_HERE

# ===================================
# ANALYTICS (OPCIONAL)
# ===================================
# Google Analytics 4 - mede canal de origem (orgânico, Instagram, direto...)
# (deixe vazio = desligado)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_GOOGLE_ADS_ID=AW-18439434622

# Meta Pixel - fecha o loop Reels/Instagram -> site -> conversão
VITE_META_PIXEL_ID=

# Posthog
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# ===================================
# FEATURE FLAGS (OPCIONAL)
# ===================================
# Habilitar modo demo
VITE_ENABLE_DEMO=false

# Habilitar modo debug
VITE_DEBUG_MODE=false

# ===================================
# INSTRUÇÕES DE USO
# ===================================
#
# 1. Copie cada variável acima
# 2. Acesse Vercel Dashboard > Seu Projeto Frontend > Settings > Environment Variables
# 3. Adicione cada variável com seu valor real
# 4. Selecione "Production" em Environment
# 5. Clique em "Save"
# 6. Faça Redeploy do projeto
#
# IMPORTANTE:
# - VITE_API_URL é obrigatório e deve apontar para o backend público
# - VITE_CLERK_PUBLISHABLE_KEY deve ser a chave pública real de PRODUÇÃO
# - Todas as variáveis VITE_* são expostas no bundle do frontend
# - NUNCA coloque chaves secretas aqui (apenas públicas)
#
# ===================================
