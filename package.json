{
  "name": "ticrif-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=18.x",
    "npm": ">=9.x"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,magenta,yellow \"npm run dev -w apps/frontend\" \"npm run dev -w apps/backend\" \"npm run worker -w apps/backend\"",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:frontend": "npm run dev -w apps/frontend",
    "typecheck": "cd apps/frontend && npm run typecheck",
    "check": "cd apps/frontend && npm run typecheck && npm test && npm run build",
    "test:frontend": "cd apps/frontend && npm test",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd apps/backend && npm install && npx prisma generate --schema=./prisma/schema.prisma && npm run build",
    "build:frontend": "cd apps/frontend && npm install && npm run build",
    "postinstall": "npm run postinstall:backend",
    "postinstall:backend": "cd apps/backend && npx prisma generate --schema=./prisma/schema.prisma",
    "migrate": "npm run migrate -w apps/backend",
    "migrate:status": "npm run migrate:status -w apps/backend",
    "migrate:deploy": "npm run migrate:deploy -w apps/backend",
    "worker": "npm run worker -w apps/backend",
    "studio": "npm run studio -w apps/backend",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:e2e": "node scripts/e2e-staging.mjs",
    "smoke": "bash scripts/smoke.sh",
    "test": "npm test -w apps/backend -- --runInBand",
    "auditoria": "node scripts/auditoria-seguranca.mjs",
    "auditoria:prod": "node scripts/auditoria-producao.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.4.0",
      "@angular-devkit/core>picomatch": "4.0.4",
      "@angular-devkit/core>ajv": "8.18.0",
      "@babel/core": "7.29.6",
      "@eslint/eslintrc>js-yaml": "4.3.2",
      "@humanfs/node": "0.16.8",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2",
      "body-parser": "2.3.0",
      "browserslist": "4.29.0",
      "cosmiconfig>js-yaml": "4.3.2",
      "deepmerge-ts": "8.0.2",
      "defu": "6.1.5",
      "fflate": "0.4.9",
      "fast-uri": "3.1.6",
      "form-data": "4.0.6",
      "lodash": "4.18.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@10>brace-expansion": "5.0.9",
      "postcss-selector-parser": "6.1.3",
      "qs": "6.16.0",
      "shell-quote": "1.9.0",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    }
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
