{
  "name": "ticrif-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=18.x",
    "pnpm": ">=10.12.4"
  },
  "scripts": {
    "dev": "concurrently -n web,api,worker -c cyan,magenta,yellow \"pnpm --dir apps/frontend dev\" \"pnpm --dir apps/backend dev\" \"pnpm --dir apps/backend worker\"",
    "dev:backend": "pnpm --dir apps/backend dev",
    "dev:frontend": "pnpm --dir apps/frontend dev",
    "typecheck": "pnpm --dir apps/frontend typecheck",
    "check": "pnpm --dir apps/frontend typecheck && pnpm --dir apps/frontend test && pnpm --dir apps/frontend build",
    "test:frontend": "pnpm --dir apps/frontend test",
    "build": "pnpm build:backend && pnpm build:frontend",
    "build:backend": "pnpm --dir apps/backend build",
    "build:frontend": "pnpm --dir apps/frontend build",
    "migrate": "pnpm --dir apps/backend migrate",
    "migrate:status": "pnpm --dir apps/backend migrate:status",
    "migrate:deploy": "pnpm --dir apps/backend migrate:deploy",
    "worker": "pnpm --dir apps/backend worker",
    "studio": "pnpm --dir apps/backend studio",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:e2e": "node scripts/e2e-staging.mjs",
    "smoke": "bash scripts/smoke.sh",
    "test": "pnpm --dir apps/backend exec jest --runInBand",
    "auditoria": "node scripts/auditoria-seguranca.mjs",
    "auditoria:prod": "node scripts/auditoria-producao.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/platform-express>multer": "2.4.0",
      "@angular-devkit/core>picomatch": "4.0.4",
      "@angular-devkit/core>ajv": "8.18.0",
      "@babel/core": "7.29.6",
      "@eslint/eslintrc>js-yaml": "4.3.2",
      "@humanfs/node": "0.16.8",
      "@istanbuljs/load-nyc-config>js-yaml": "3.15.2",
      "body-parser": "2.3.0",
      "browserslist": "4.29.0",
      "cosmiconfig>js-yaml": "4.3.2",
      "deepmerge-ts": "8.0.2",
      "defu": "6.1.5",
      "fflate": "0.4.9",
      "fast-uri": "3.1.6",
      "form-data": "4.0.6",
      "lodash": "4.18.0",
      "minimatch@3>brace-expansion": "1.1.18",
      "minimatch@10>brace-expansion": "5.0.9",
      "postcss-selector-parser": "6.1.3",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "shell-quote": "1.11.0",
      "undici": "7.29.0",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    }
  }
}
